# ==========================================
# GabaySJNHS Environment Configuration
# Copy this file to `.env.local` for local development
# ==========================================

# 1. Supabase Project Configuration
# Find these in your Supabase Dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Enrollment Officer Session Signing Secret
# Any secure random string (used to sign 10-hour JWT cookies)
OFFICER_JWT_SECRET=your-random-32-char-secret-key-for-officer-sessions

# 3. Free OCR.Space API Key (Optional)
# Get a free key at: https://ocr.space/ocrapi
OCR_SPACE_API_KEY=K88723657388957
